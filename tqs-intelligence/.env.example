# Core
TQS_DB_PATH=./data/tqs-intelligence.duckdb
TQS_LAB_DB_PATH=./data/tqs-lab.sqlite3
TQS_ACCOUNTS_DB_PATH=./data/tqs-accounts.sqlite3
TQS_CONTROL_PATH=./data/control.json
TQS_REFRESH_SECONDS=60
TQS_HOST=127.0.0.1
TQS_PORT=8787

# Runtime control: stop | light | max
TQS_MODE=light
TQS_HEAVY_WORKERS=2
TQS_AUTO_UPDATE=true

# Heavy historical storage. Windows installer prefers D:\TQS_DATA automatically when available.
TQS_DATA_LAKE_ROOT=./data-lake

# Optional local Google Drive Desktop folder. Snapshot ZIP files are copied here automatically.
TQS_DRIVE_EXPORT_ROOT=

# Autonomous anomaly episode engine
TQS_EPISODE_THRESHOLD=70
TQS_EPISODE_CLOSE_GRACE_SECONDS=180
TQS_HISTORY_BACKFILL_MAX=8
TQS_HISTORY_REFRESH_EVERY=5
TQS_RESEARCH_EVERY_REFRESHES=15

# Public account / position intelligence.
# Add Hyperliquid public 0x addresses comma-separated, or add them later from the Russian UI.
TQS_ACCOUNT_REFRESH_SECONDS=60
TQS_ACCOUNT_HISTORY_DAYS=30
TQS_HYPERLIQUID_WALLETS=

# Zero-key market sources
TQS_ENABLE_BITGET=true
TQS_ENABLE_BINANCE=true
TQS_ENABLE_BYBIT=true
TQS_ENABLE_OKX=true
TQS_ENABLE_MOEX=true

# Optional global stocks/ETF/FX provider. Leave empty to disable.
TQS_TWELVE_DATA_API_KEY=
TQS_TWELVE_DATA_SYMBOLS=AAPL,MSFT,NVDA,SPY,QQQ

# Optional comma-separated RSS/Atom feeds. GDELT news works without a key.
TQS_RSS_URLS=

# Future premium MOEX / news providers. Keep secrets only in .env, never commit them.
TQS_MOEX_PREMIUM_ENABLED=false
TQS_MOEX_PREMIUM_TOKEN=
TQS_TELEGRAM_NEWS_ENABLED=false
TQS_TELEGRAM_API_ID=
TQS_TELEGRAM_API_HASH=

# Server mode. Keep 127.0.0.1 unless a reverse proxy/VPN protects access.
TQS_SERVER_BIND=127.0.0.1

<Window x:Class="TQS.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="TQS Intelligence" Width="1560" Height="930" MinWidth="1180" MinHeight="720"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="#090B0E" Foreground="#F4F1EA" xml:lang="ru-RU">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44" ResizeBorderThickness="7" CornerRadius="14" GlassFrameThickness="0"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#10151A"/>
            <Setter Property="BorderBrush" Value="#252D35"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="12"/>
        </Style>
        <Style x:Key="TinyButton" TargetType="Button" BasedOn="{StaticResource SoftButton}">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="9,5"/>
        </Style>
        <Style TargetType="ProgressBar">
            <Setter Property="Height" Value="5"/>
            <Setter Property="Background" Value="#1C232A"/>
            <Setter Property="Foreground" Value="#CDA25F"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="330"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="54"/>
            <RowDefinition Height="86"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Left navigation -->
        <Border Grid.Column="0" Grid.RowSpan="3" Background="#0C1014" BorderBrush="#20262D" BorderThickness="0,0,1,0">
            <Grid Margin="13,11,13,13">
                <Grid.RowDefinitions>
                    <RowDefinition Height="62"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Width="36" Height="36" CornerRadius="11" Background="#CDA25F" VerticalAlignment="Center">
                        <TextBlock Text="TQ" Foreground="#17130D" FontWeight="Bold" FontSize="14"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="9,0,0,0">
                        <TextBlock Text="TQS Intelligence" FontSize="14" FontWeight="SemiBold"/>
                        <TextBlock Text="MARKET RESEARCH OS" Foreground="#6C747D" FontSize="9" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="1" Margin="0,10,0,0">
                    <TextBlock Text="&#x0420;&#x0410;&#x0417;&#x0414;&#x0415;&#x041B;&#x042B;" Foreground="#59616B"
                               FontSize="9" FontWeight="SemiBold" Margin="11,0,0,6"/>
                    <Button Style="{StaticResource NavButton}" Content="&#x041E;&#x0431;&#x0437;&#x043E;&#x0440;" Tag="" Click="Nav_Click"/>
                    <Button Style="{StaticResource NavButton}" Content="&#x041C;&#x043E;&#x0441;&#x0431;&#x0438;&#x0440;&#x0436;&#x0430;" Tag="moex" Click="Nav_Click"/>
                    <Button Style="{StaticResource NavButton}" Content="&#x0423;&#x0447;&#x0430;&#x0441;&#x0442;&#x043D;&#x0438;&#x043A;&#x0438;" Tag="participants" Click="Nav_Click"/>
                    <Button Style="{StaticResource NavButton}" Content="&#x0418;&#x043D;&#x0441;&#x0442;&#x0440;&#x0443;&#x043C;&#x0435;&#x043D;&#x0442;" Tag="instrument" Click="Nav_Click"/>
                    <Button Style="{StaticResource NavButton}" Content="&#x0418;&#x0441;&#x0441;&#x043B;&#x0435;&#x0434;&#x043E;&#x0432;&#x0430;&#x043D;&#x0438;&#x044F;" Tag="research" Click="Nav_Click"/>
                    <Button Style="{StaticResource NavButton}" Content="&#x0421;&#x0442;&#x0440;&#x0430;&#x0442;&#x0435;&#x0433;&#x0438;&#x0438;" Tag="research" Click="Nav_Click"/>
                    <Button Style="{StaticResource NavButton}" Content="&#x0414;&#x0430;&#x043D;&#x043D;&#x044B;&#x0435;" Tag="data" Click="Nav_Click"/>
                    <Button Style="{StaticResource NavButton}" Content="&#x0421;&#x0438;&#x0441;&#x0442;&#x0435;&#x043C;&#x0430;" Tag="system" Click="Nav_Click"/>
                </StackPanel>

                <Border Grid.Row="2" Style="{StaticResource Card}" Padding="10">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="SidebarDot" Width="7" Height="7" Fill="#59616B" Margin="0,2,7,0"/>
                            <TextBlock x:Name="SidebarState" Text="&#x0417;&#x0430;&#x043F;&#x0443;&#x0441;&#x043A;..." FontSize="11" FontWeight="SemiBold"/>
                        </StackPanel>
                        <TextBlock x:Name="SidebarDetail" Text="&#x041E;&#x0434;&#x0438;&#x043D; runtime &#x00B7; &#x0431;&#x0435;&#x0437; &#x0445;&#x0432;&#x043E;&#x0441;&#x0442;&#x043E;&#x0432;"
                                   Foreground="#68717A" FontSize="9" Margin="14,5,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Native title bar -->
        <Grid Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="0" Background="#0A0D10"
              MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                <TextBlock x:Name="SectionTitle" Text="&#x041E;&#x0431;&#x0437;&#x043E;&#x0440;" FontSize="14" FontWeight="SemiBold"/>
                <Border x:Name="StatusPill" Background="#161D22" BorderBrush="#2A333C" BorderThickness="1"
                        CornerRadius="12" Margin="11,0,0,0" Padding="9,4">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="#59616B" Margin="0,0,6,0"/>
                        <TextBlock x:Name="StatusText" Text="&#x0417;&#x0410;&#x041F;&#x0423;&#x0421;&#x041A;" FontSize="10" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                <Button Style="{StaticResource SoftButton}" Content="&#x2014;" Width="42" Height="31" Padding="0"
                        Click="Minimize_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                <Button Style="{StaticResource SoftButton}" Content="&#x25A1;" Width="42" Height="31" Padding="0" Margin="6,0,0,0"
                        Click="Maximize_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                <Button Style="{StaticResource DangerButton}" Content="&#x00D7;" Width="42" Height="31" Padding="0" Margin="6,0,0,0"
                        Click="Close_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
            </StackPanel>
        </Grid>

        <!-- One clear control strip -->
        <Border Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="1" Margin="16,7,16,9"
                Background="#10151A" BorderBrush="#252D35" BorderThickness="1" CornerRadius="13">
            <Grid Margin="13,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="WorkToggle" Grid.Column="0" Style="{StaticResource AccentButton}"
                        Content="&#x041D;&#x0430;&#x0447;&#x0430;&#x0442;&#x044C; &#x0440;&#x0430;&#x0431;&#x043E;&#x0442;&#x0443;" Width="138"
                        Click="WorkToggle_Click"/>
                <Button Grid.Column="2" Style="{StaticResource SoftButton}"
                        Content="&#x041E;&#x0431;&#x043D;&#x043E;&#x0432;&#x0438;&#x0442;&#x044C; &#x0440;&#x044B;&#x043D;&#x043E;&#x043A;" Width="142"
                        Click="RefreshMarket_Click"/>

                <Grid Grid.Column="4" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,13,0">
                        <TextBlock Text="&#x041D;&#x0430;&#x0433;&#x0440;&#x0443;&#x0437;&#x043A;&#x0430;" Foreground="#8A939C" FontSize="10"/>
                        <TextBlock x:Name="LoadModeText" Text="&#x0410;&#x0432;&#x0442;&#x043E;" FontSize="12" FontWeight="SemiBold" Margin="0,3,0,0"/>
                    </StackPanel>
                    <Slider x:Name="LoadSlider" Grid.Column="1" Minimum="20" Maximum="100" Value="70"
                            TickFrequency="10" IsSnapToTickEnabled="False" VerticalAlignment="Center"
                            PreviewMouseLeftButtonUp="LoadSlider_MouseUp"/>
                    <TextBlock x:Name="LoadValueText" Grid.Column="2" Text="70%" Width="42" TextAlignment="Right"
                               FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </Grid>

                <CheckBox x:Name="AutoLoadCheck" Grid.Column="6" IsChecked="True"
                          Content="&#x0410;&#x0432;&#x0442;&#x043E;" VerticalAlignment="Center"
                          Foreground="#C5CAD0" FontSize="12" Checked="AutoLoadCheck_Changed" Unchecked="AutoLoadCheck_Changed"/>
            </Grid>
        </Border>

        <!-- Embedded cockpit: only content, no duplicate chrome -->
        <Border Grid.Column="1" Grid.Row="2" Margin="16,0,8,16" CornerRadius="14"
                Background="#0C1014" BorderBrush="#252D35" BorderThickness="1" ClipToBounds="True">
            <Grid>
                <wv2:WebView2 x:Name="Cockpit" Visibility="Collapsed"/>
                <Grid x:Name="OfflinePanel" Background="#0D1115">
                    <StackPanel Width="460" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Width="52" Height="52" CornerRadius="17" Background="#171D23" BorderBrush="#2C353E" BorderThickness="1">
                            <TextBlock Text="TQ" Foreground="#CDA25F" FontSize="16" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="OfflineTitle" Text="&#x0417;&#x0430;&#x043F;&#x0443;&#x0441;&#x043A; TQS" FontSize="24" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Margin="0,17,0,0"/>
                        <TextBlock x:Name="OfflineDetail"
                                   Text="&#x041F;&#x043E;&#x0434;&#x043D;&#x0438;&#x043C;&#x0430;&#x044E; &#x0434;&#x0432;&#x0438;&#x0436;&#x043E;&#x043A; &#x0438; &#x043F;&#x0440;&#x043E;&#x0432;&#x0435;&#x0440;&#x044F;&#x044E; &#x0441;&#x043E;&#x0441;&#x0442;&#x043E;&#x044F;&#x043D;&#x0438;&#x0435;."
                                   Foreground="#8C949D" FontSize="12" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                </Grid>
                <Border x:Name="BusyOverlay" Visibility="Collapsed" Background="#CC090B0E">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ProgressBar Width="220" IsIndeterminate="True"/>
                        <TextBlock x:Name="BusyText" Text="&#x0412;&#x044B;&#x043F;&#x043E;&#x043B;&#x043D;&#x044F;&#x044E;..."
                                   FontSize="12" Foreground="#AAB0B7" HorizontalAlignment="Center" Margin="0,13,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Lightweight native status rail -->
        <Border Grid.Column="2" Grid.Row="2" Margin="8,0,16,16" Background="#0C1014"
                BorderBrush="#252D35" BorderThickness="1" CornerRadius="14">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="12">
                    <TextBlock Text="&#x0421;&#x0435;&#x0439;&#x0447;&#x0430;&#x0441;" FontSize="12" Foreground="#808991" FontWeight="SemiBold"/>
                    <TextBlock x:Name="CurrentActionText" Text="&#x041E;&#x0436;&#x0438;&#x0434;&#x0430;&#x043D;&#x0438;&#x0435;" FontSize="17"
                               FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,6,0,2"/>
                    <TextBlock x:Name="CurrentActionDetail" Text="&#x041D;&#x0435;&#x0442; &#x0430;&#x043A;&#x0442;&#x0438;&#x0432;&#x043D;&#x044B;&#x0445; &#x0437;&#x0430;&#x0434;&#x0430;&#x0447;"
                               Foreground="#78818A" FontSize="10" TextWrapping="Wrap"/>

                    <TextBlock Text="&#x0420;&#x0435;&#x0441;&#x0443;&#x0440;&#x0441;&#x044B;" FontSize="12" Foreground="#808991" FontWeight="SemiBold" Margin="0,18,0,7"/>
                    <UniformGrid Columns="2" Rows="2">
                        <Border Style="{StaticResource Card}" Margin="0,0,5,5">
                            <StackPanel><TextBlock Text="CPU" Foreground="#6F7983" FontSize="9"/>
                                <TextBlock x:Name="CpuText" Text="--" FontSize="19" FontWeight="SemiBold" Margin="0,3,0,0"/>
                                <TextBlock x:Name="TqsCpuText" Text="TQS --" Foreground="#6F7983" FontSize="9"/></StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="5,0,0,5">
                            <StackPanel><TextBlock Text="RAM" Foreground="#6F7983" FontSize="9"/>
                                <TextBlock x:Name="RamText" Text="--" FontSize="19" FontWeight="SemiBold" Margin="0,3,0,0"/>
                                <TextBlock x:Name="TqsRamText" Text="TQS --" Foreground="#6F7983" FontSize="9"/></StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,5,5,0">
                            <StackPanel><TextBlock Text="&#x0421;&#x0435;&#x0442;&#x044C; &#x041F;&#x041A;" Foreground="#6F7983" FontSize="9"/>
                                <TextBlock x:Name="NetworkText" Text="--" FontSize="12" FontWeight="SemiBold" Margin="0,5,0,0" TextWrapping="Wrap"/>
                                <TextBlock Text="&#x0412;&#x0445;&#x043E;&#x0434; / &#x0432;&#x044B;&#x0445;&#x043E;&#x0434;" Foreground="#6F7983" FontSize="9"/></StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="5,5,0,0">
                            <StackPanel><TextBlock Text="&#x0414;&#x0438;&#x0441;&#x043A;" Foreground="#6F7983" FontSize="9"/>
                                <TextBlock x:Name="DiskText" Text="--" FontSize="12" FontWeight="SemiBold" Margin="0,5,0,0" TextWrapping="Wrap"/>
                                <TextBlock Text="&#x0427;&#x0442;&#x0435;&#x043D;&#x0438;&#x0435; / &#x0437;&#x0430;&#x043F;&#x0438;&#x0441;&#x044C;" Foreground="#6F7983" FontSize="9"/></StackPanel>
                        </Border>
                    </UniformGrid>
                    <TextBlock x:Name="WorkerText" Text="&#x0412;&#x043E;&#x0440;&#x043A;&#x0435;&#x0440;&#x044B;: --" Foreground="#8A939C" FontSize="10" Margin="1,8,0,0"/>
                    <TextBlock x:Name="ProcessSummaryText" Text="&#x041F;&#x0440;&#x043E;&#x0446;&#x0435;&#x0441;&#x0441;&#x044B; TQS: --" Foreground="#68717A" FontSize="9" Margin="1,3,0,0" TextWrapping="Wrap"/>

                    <TextBlock Text="&#x0417;&#x0430;&#x0434;&#x0430;&#x0447;&#x0438;" FontSize="12" Foreground="#808991" FontWeight="SemiBold" Margin="0,18,0,7"/>
                    <CheckBox x:Name="AutoTasksCheck" Content="&#x0414;&#x043E;&#x0431;&#x0430;&#x0432;&#x043B;&#x044F;&#x0442;&#x044C; &#x043D;&#x043E;&#x0432;&#x044B;&#x0435; &#x0437;&#x0430;&#x0434;&#x0430;&#x0447;&#x0438; &#x0430;&#x0432;&#x0442;&#x043E;&#x043C;&#x0430;&#x0442;&#x0438;&#x0447;&#x0435;&#x0441;&#x043A;&#x0438;"
                              Foreground="#A8AFB6" FontSize="10" IsChecked="False" Margin="2,0,0,9"
                              Checked="AutoTasksCheck_Changed" Unchecked="AutoTasksCheck_Changed"/>
                    <StackPanel x:Name="TasksPanel"/>
                    <TextBlock x:Name="NoTasksText" Text="&#x041E;&#x0447;&#x0435;&#x0440;&#x0435;&#x0434;&#x044C; &#x043F;&#x0443;&#x0441;&#x0442;&#x0430;"
                               Foreground="#66707A" FontSize="10" Margin="2,4,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>

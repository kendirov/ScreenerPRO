<Window x:Class="TQS.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="TQS Intelligence" Width="1480" Height="920" MinWidth="1120" MinHeight="720"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="#090B0E" Foreground="#F4F1EA">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42" ResizeBorderThickness="7" CornerRadius="14" GlassFrameThickness="0"/>
    </shell:WindowChrome.WindowChrome>

    <Grid Background="#090B0E">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="246"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#0D1014" BorderBrush="#20262D" BorderThickness="0,0,1,0">
            <Grid Margin="14,12,14,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="64"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="42"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="36" Height="36" CornerRadius="11" Background="#CDA25F" VerticalAlignment="Center">
                        <TextBlock Text="TQ" Foreground="#17130D" FontWeight="Bold" FontSize="14"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="9,0,0,0">
                        <TextBlock Text="TQS Intelligence" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="MARKET RESEARCH OS" Foreground="#737B84" FontSize="9" FontWeight="SemiBold" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>

                <Button Grid.Row="1" x:Name="NewResearchButton" Style="{StaticResource AccentButton}"
                        Content="+  РќРѕРІРѕРµ РёСЃСЃР»РµРґРѕРІР°РЅРёРµ" Margin="0,7,0,12" Click="NewResearch_Click"/>

                <StackPanel Grid.Row="2">
                    <TextBlock Text="Р РђР‘РћР§Р•Р• РџР РћРЎРўР РђРќРЎРўР’Рћ" Foreground="#59616B" FontSize="9" FontWeight="SemiBold"
                               Margin="10,4,0,5"/>
                    <Button Style="{StaticResource NavButton}" Content="РћР±Р·РѕСЂ" Tag="" Click="Nav_Click"/>
                    <Button Style="{StaticResource NavButton}" Content="Р С‹РЅРѕРє" Tag="market" Click="Nav_Click"/>
                    <Button Style="{StaticResource NavButton}" Content="РђРЅРѕРјР°Р»РёРё" Tag="anomalies" Click="Nav_Click"/>
                    <Button Style="{StaticResource NavButton}" Content="РџРѕС‚РµРЅС†РёР°Р»СЊРЅС‹Рµ РІС…РѕРґС‹" Tag="entries" Click="Nav_Click"/>
                    <Button Style="{StaticResource NavButton}" Content="РСЃСЃР»РµРґРѕРІР°РЅРёСЏ" Tag="research" Click="Nav_Click"/>
                    <Button Style="{StaticResource NavButton}" Content="РЎС‚СЂР°С‚РµРіРёРё" Tag="strategies" Click="Nav_Click"/>
                    <Button Style="{StaticResource NavButton}" Content="Instrument Lab" Tag="instrument-lab" Click="Nav_Click"/>

                    <TextBlock Text="РЎРРЎРўР•РњРђ" Foreground="#59616B" FontSize="9" FontWeight="SemiBold"
                               Margin="10,20,0,5"/>
                    <Button Style="{StaticResource NavButton}" Content="Р”Р°РЅРЅС‹Рµ Рё РёСЃС‚РѕС‡РЅРёРєРё" Tag="data" Click="Nav_Click"/>
                    <Button Style="{StaticResource NavButton}" Content="РЎРѕСЃС‚РѕСЏРЅРёРµ СЃРёСЃС‚РµРјС‹" Tag="system" Click="Nav_Click"/>
                </StackPanel>

                <Border Grid.Row="3" Background="#11161B" BorderBrush="#242C34" BorderThickness="1"
                        CornerRadius="11" Padding="11">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="SidebarDot" Width="7" Height="7" Fill="#59616B" Margin="0,1,7,0"/>
                            <TextBlock x:Name="SidebarState" Text="Runtime stopped" FontSize="11" FontWeight="SemiBold"/>
                        </StackPanel>
                        <TextBlock Text="Р—Р°РєСЂС‹С‚РёРµ РїСЂРёР»РѕР¶РµРЅРёСЏ = РїРѕР»РЅС‹Р№ stop" Foreground="#68717A" FontSize="9" Margin="14,5,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="58"/>
                <RowDefinition Height="82"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="#0A0D10" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="22,0,0,0">
                    <TextBlock x:Name="SectionTitle" Text="РћР±Р·РѕСЂ" FontSize="14" FontWeight="SemiBold"/>
                    <Border x:Name="StatusPill" Background="#1B2127" BorderBrush="#303943" BorderThickness="1"
                            CornerRadius="12" Margin="12,0,0,0" Padding="9,4">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="#59616B" Margin="0,0,6,0"/>
                            <TextBlock x:Name="StatusText" Text="STOPPED" FontSize="10" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                    <Button Style="{StaticResource SoftButton}" Content="вЂ”" Width="42" Height="32" Padding="0"
                            Click="Minimize_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button Style="{StaticResource SoftButton}" Content="в–Ў" Width="42" Height="32" Padding="0" Margin="6,0,0,0"
                            Click="Maximize_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button Style="{StaticResource DangerButton}" Content="Г—" Width="42" Height="32" Padding="0" Margin="6,0,0,0"
                            Click="Close_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Margin="18,8,18,10" Background="#11161B" BorderBrush="#252D35"
                    BorderThickness="1" CornerRadius="13">
                <Grid Margin="14,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="SESSION" Foreground="#666F78" FontSize="9" FontWeight="SemiBold"/>
                        <TextBlock x:Name="SessionText" Text="Not running" FontSize="13" FontWeight="SemiBold" Margin="0,4,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="PROCESS" Foreground="#666F78" FontSize="9" FontWeight="SemiBold"/>
                        <TextBlock x:Name="PidText" Text="вЂ”" FontSize="13" FontWeight="SemiBold" Margin="0,4,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4">
                        <TextBlock Text="MODE" Foreground="#666F78" FontSize="9" FontWeight="SemiBold"/>
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                            <Button Style="{StaticResource SoftButton}" Content="STOP" Padding="8,4" FontSize="10" Click="ModeStop_Click"/>
                            <Button Style="{StaticResource SoftButton}" Content="LIGHT" Padding="8,4" FontSize="10" Margin="5,0,0,0" Click="ModeLight_Click"/>
                            <Button Style="{StaticResource SoftButton}" Content="MAX" Padding="8,4" FontSize="10" Margin="5,0,0,0" Click="ModeMax_Click"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="StartButton" Style="{StaticResource AccentButton}" Content="Start" Width="84" Click="Start_Click"/>
                        <Button x:Name="RestartButton" Style="{StaticResource SoftButton}" Content="Restart" Width="84" Margin="7,0,0,0" Click="Restart_Click"/>
                        <Button x:Name="StopButton" Style="{StaticResource DangerButton}" Content="Stop" Width="84" Margin="7,0,0,0" Click="Stop_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="2" Margin="18,0,18,18" CornerRadius="15" Background="#0D1115"
                    BorderBrush="#252D35" BorderThickness="1" ClipToBounds="True">
                <Grid>
                    <wv2:WebView2 x:Name="Cockpit" Visibility="Collapsed"/>
                    <Grid x:Name="OfflinePanel" Background="#0D1115">
                        <StackPanel Width="470" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Width="54" Height="54" CornerRadius="18" Background="#171D23" BorderBrush="#2C353E" BorderThickness="1">
                                <TextBlock Text="TQ" Foreground="#CDA25F" FontSize="16" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock x:Name="OfflineTitle" Text="TQS РѕСЃС‚Р°РЅРѕРІР»РµРЅ" FontSize="28" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Margin="0,18,0,0"/>
                            <TextBlock x:Name="OfflineDetail"
                                       Text="Р—Р°РїСѓСЃС‚Рё СЃРµСЃСЃРёСЋ вЂ” РґР°РЅРЅС‹Рµ, Р°РЅРѕРјР°Р»РёРё, РёСЃСЃР»РµРґРѕРІР°РЅРёСЏ Рё СЃС‚СЂР°С‚РµРіРёРё Р±СѓРґСѓС‚ СЂР°Р±РѕС‚Р°С‚СЊ РІРЅСѓС‚СЂРё РѕРґРЅРѕРіРѕ СѓРїСЂР°РІР»СЏРµРјРѕРіРѕ РїСЂРѕС†РµСЃСЃР°."
                                       Foreground="#8C949D" FontSize="13" TextAlignment="Center" TextWrapping="Wrap"
                                       Margin="0,9,0,0"/>
                            <Button Style="{StaticResource AccentButton}" Content="Р—Р°РїСѓСЃС‚РёС‚СЊ TQS" Width="150"
                                    HorizontalAlignment="Center" Margin="0,20,0,0" Click="Start_Click"/>
                        </StackPanel>
                    </Grid>

                    <Border x:Name="BusyOverlay" Visibility="Collapsed" Background="#CC090B0E">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ProgressBar Width="220" Height="3" IsIndeterminate="True" Foreground="#CDA25F"/>
                            <TextBlock x:Name="BusyText" Text="Р—Р°РїСѓСЃРє TQSвЂ¦" FontSize="13" Foreground="#AAB0B7"
                                       HorizontalAlignment="Center" Margin="0,14,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>


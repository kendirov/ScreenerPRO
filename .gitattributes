# Auto-detect text files and normalize line endings to LF in the repo.
* text=auto eol=lf

# Force LF for files that must be Unix-style.
*.sh        text eol=lf
*.ts        text eol=lf
*.tsx       text eol=lf
*.js        text eol=lf
*.mjs       text eol=lf
*.cjs       text eol=lf
*.json      text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.md        text eol=lf
*.css       text eol=lf
*.html      text eol=lf
*.prisma    text eol=lf

# Force CRLF for Windows-only scripts so they still execute on Windows
# after being committed from macOS/Linux.
*.cmd       text eol=crlf
*.bat       text eol=crlf
*.ps1       text eol=crlf

# Binary files (no diff, no LF conversion).
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.webp      binary
*.ico       binary
*.svg       text eol=lf
*.woff      binary
*.woff2     binary
*.db        binary
*.db-journal binary

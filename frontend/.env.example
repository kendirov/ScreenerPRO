NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Показать блок «Черновики» в sidebar (draft-деплой). На main — не задавать или false.
NEXT_PUBLIC_SHOW_DRAFT_NAV=
DATABASE_URL="file:./prisma/dev.db"
MOEX_BASE_URL="https://iss.moex.com/iss"
MOEX_HTTP_TIMEOUT_MS="12000"
# Режим данных MOEX ISS (см. docs/MOEX_DATA_PIPELINE.md):
#   live     — default; live MOEX, при ошибке 503 (без auto-demo)
#   fallback — dev-only; после провала live → учебный набор (source=fallback, isDemo=true)
#   off      — не ходить в MOEX, пустой ответ (source=off)
# Не задавайте off по умолчанию. После смены режима перезапустите dev-сервер.
# Shell env (MOEX_DATA_MODE=off pnpm dev) перебивает .env до перезапуска.
MOEX_DATA_MODE="live"
# Demo rows только при MOEX_DATA_MODE=fallback или явно true (локальная разработка).
ALLOW_DEMO_MARKET_DATA="false"
# Подготовка · внешний фон и события (опционально — без ключей build не ломается)
TRADING_ECONOMICS_API_KEY=
FINNHUB_API_KEY=
FMP_API_KEY=
EODHD_API_KEY=

# Bitget private UTA v3 — server-only. Никогда не использовать NEXT_PUBLIC_*.
BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_API_PASSPHRASE=
